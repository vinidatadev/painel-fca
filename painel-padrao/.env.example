VITE_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_AZURE_REDIRECT_URI=http://localhost
# M-5: a API agora é servida pelo Nginx (porta 80) como reverse proxy,
# sem expor o backend (8000) diretamente no host.
VITE_API_URL=http://localhost

# --- Credenciais de infra (compose as exige — sem defaults inseguros) ---
DB_USER= Defina-um-usuario-postgres
DB_PASSWORD= Defina-uma-senha-forte
DB_NAME=appdb

# Credenciais do MinIO (devem casar com backend/.env)
MINIO_USER= Defina-um-usuario-minio
MINIO_PASSWORD= Defina-uma-senha-forte