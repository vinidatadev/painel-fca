# PostgreSQL
DATABASE_URL=postgresql+asyncpg://usuario:senha@host:5432/nome_banco

# Azure AD
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# JWT local — gere um segredo forte: python -c "import secrets; print(secrets.token_hex(32))"
# AVISO: o backend recusa iniciar se JWT_SECRET estiver vazio, for o placeholder
#        abaixo ou tiver menos de 16 caracteres.
JWT_SECRET= Defina-um-segredo-forte-aqui-com-32-hex-ou-mais
JWT_EXPIRE_H=8

# CORS
ALLOWED_ORIGINS=http://localhost:5173,https://seudominio.com

# MinIO — credenciais OBRIGATÓRIAS (sem fallback inseguro)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY= Defina-uma-access-key-forte
MINIO_SECRET_KEY= Defina-uma-secret-key-forte
MINIO_BUCKET=fca-anexos
MINIO_PUBLIC_URL=http://localhost:9000

# Frontend (para links nos e-mails)
FRONTEND_URL=http://localhost

# SMTP (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@fca.local
